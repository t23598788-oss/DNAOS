{
  "domain": "vehicle",
  "tables": [
    {
      "table": "vehicle_types",
      "primaryKey": "id",
      "description": "ประเภทรถ — ขนาด น้ำหนักบรรทุก",
      "columns": ["id", "name", "capacity", "created_at", "deleted_at"],
      "softDelete": true
    }
  ],
  "relations": [
    { "table": "jobs", "foreignKey": "vehicle_type_id", "type": "foreign_key" }
  ],
  "indexes": [],
