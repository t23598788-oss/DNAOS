    "read": ["Cognitive Pipeline", "Pricing Engine", "Transport Engine"],
    "write": ["V6 Executor"]
  },
  "commands": ["review_vehicle"],
  "events": ["vehicle.created", "vehicle.updated"],
  "engines": [
    { "name": "Pricing Engine", "file": "lib/v3-engines/pricing/engine.ts", "function": "calcTransportPrice" }
  ],
  "queries": [],
  "dependencies": [],
  "validators": [
    { "rule": "ต้องมี name", "field": "name", "type": "required" },
    { "rule": "capacity > 0", "field": "capacity", "type": "positive" }
  ],
  "documents": [],
  "api": []
}
