{
  "version": 1,
  "policy": "ทุก Business Domain ต้องรู้ว่าครอบคลุมแค่ไหน",
  "domains": {
    "sales": {
      "label": "งานขาย / เสนอราคา",
      "status": "covered",
      "modules": ["engines/pricing", "engines/cost", "engines/distance", "engines/fuel", "engines/capacity", "engines/time"],
      "commands": ["business.calculate_price", "calc.price", "calc.distance"],
      "workflows": ["doc.generate", "doc.preview"],
      "documents": ["quotation", "invoice"]
    },
    "purchase": {
      "label": "งานจัดซื้อ",
      "status": "covered",
      "modules": ["cognitive/partners", "engines/validation/resolver"],
      "commands": ["partner.list", "partner.find"],
      "workflows": ["db.search_partner"],
      "documents": ["purchase-order"]
    },
    "debt": {
      "label": "ลูกหนี้ / ติดตามหนี้",
      "status": "covered",
      "modules": ["engines/debt/engine", "engines/debt/interest", "engines/debt/collection", "engines/debt/status", "engines/debt/transition", "engines/debt/scheduler", "engines/debt/calculator", "cognitive/debts"],
      "commands": ["debt.list", "debt.all", "debt.trackings", "debt.create", "business.calculate_debt"],
      "workflows": ["db.search_debt"],
      "documents": ["invoice"]
    },
    "tax": {
      "label": "ภาษี / VAT / หัก ณ ที่จ่าย",
      "status": "covered",
      "modules": ["engines/tax"],
      "commands": ["business.calculate_tax"],
      "workflows": [],
      "documents": ["receipt"]
    },
    "transport": {
      "label": "ขนส่ง / จัดส่งวัสดุ",
      "status": "covered",
      "modules": ["engines/distance", "engines/fuel", "engines/capacity", "engines/time", "engines/cost"],
      "commands": ["job.list", "job.active"],
      "workflows": ["calc.distance"],
      "documents": ["delivery-order"]
    },
    "document": {
      "label": "เอกสาร / ใบเสนอราคา / ใบแจ้งหนี้",
      "status": "covered",
      "modules": ["engines/documents/engine", "cognitive/documents", "cognitive/invoices"],
      "commands": ["document.list", "document.create", "invoice.list", "invoice.create", "receipt.create"],
      "workflows": ["doc.generate", "doc.preview"],
      "documents": ["quotation", "invoice", "receipt", "boq", "delivery-order", "purchase-order"]
    },
    "communication": {
      "label": "LINE / Email / แจ้งเตือน",
      "status": "covered",
      "modules": ["cognitive/line", "plugins/drivers/line"],
      "commands": ["line.send", "line.read"],
      "workflows": ["line.send", "chat.read", "email.send"],
      "documents": []
    },
    "inventory": {
      "label": "คลังสินค้า / สต๊อกวัสดุ",
      "status": "not_covered",
      "modules": [],
      "commands": [],
      "workflows": [],
      "documents": [],
      "gap": "ยังไม่มี module สำหรับจัดการคลังสินค้า / สต๊อก"
    },
    "hr": {
      "label": "บุคลากร / คนขับรถ / ช่าง",
      "status": "not_covered",
      "modules": [],
      "commands": [],
      "workflows": [],
      "documents": [],
      "gap": "ยังไม่มี module สำหรับจัดการบุคลากร"
    },
    "maintenance": {
      "label": "ซ่อมบำรุง / เครื่องจักร",
      "status": "partial",
      "modules": [
        "engines/equipment/relay-command.ts",
        "app/api/admin/equipment/route.ts",
        "app/api/admin/equipment/trigger-start/route.ts",
        "app/api/admin/equipment/toggle-permission/route.ts",
        "app/admin/equipment/page.tsx"
      ],
      "commands": [],
      "workflows": [],
      "documents": ["docs/equipment-maintenance-lock-module.md"],
      "gap": "มี equipment_assets/driver_equipment_permissions + admin toggle + relay-command engine (gated, รอ SMS gateway จริง) แต่ยังไม่มี telemetry ingestion, engine-hours accumulation, maintenance ticket ที่ 250h, auto-lock ที่ +50h เกิน หรือ shift-lock 17:00 — รายละเอียดเต็มดู docs/equipment-maintenance-lock-module.md (correction 2026-07-24: ก่อนหน้านี้อ้าง 'kis-webhook' ซึ่งไม่มีไฟล์จริงรองรับ)"
    },
    "accounting": {
      "label": "บัญชี / งบการเงิน",
      "status": "not_covered",
      "modules": [],
      "commands": [],
      "workflows": [],
      "documents": [],
      "gap": "ยังไม่มี module สำหรับบัญชี/งบการเงิน"
    },
    "relationship": {
      "label": "ความสัมพันธ์ธุรกิจ / Business Timeline",
      "status": "covered",
      "design_principle": "เอกสารคือ artifact ของ event ไม่ใช่ตัว event เอง — ศูนย์กลางคือ partner + timeline",
      "modules": [
        "engines/partner/timeline",
        "app/admin/partners/page",
        "app/admin/partners/[id]/page"
      ],
      "commands": [
        "partner.list",
        "partner.timeline"
      ],
      "workflows": [],
      "documents": [],
      "gap": "business_events ยังว่างอยู่ (phase 1 ใช้ documents เป็นหลัก) — phase 2 คือ event capture จาก LINE + manual note"
    }
