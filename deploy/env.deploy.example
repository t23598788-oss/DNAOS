# ============================================================
# Template สำหรับ deploy ขึ้น Google Cloud Run
# วิธีใช้:
#   cp deploy/env.deploy.example .env.deploy
#   # เติมค่าจริงใน .env.deploy (ไฟล์นี้ถูก .gitignore ไว้แล้ว)
#   set -a; source .env.deploy; set +a
#   ./deploy-full.sh --dry-run
#   CONFIRM_DEPLOY=yes ./deploy-full.sh
# ============================================================

# ---- Google Cloud (บังคับ) ----
# หาได้จาก: https://console.cloud.google.com -> project selector -> Project ID
GCP_PROJECT_ID="your-project-id"
GCP_REGION="asia-southeast1"
SERVICE_NAME="dna-runtime"

# ---- Supabase (บังคับ) ----
# หาได้จาก: Supabase Dashboard -> Settings -> API Keys
SB_URL="https://<project-ref>.supabase.co"
SB_ANON="eyJ...anon..."
SB_SERVICE_ROLE="eyJ...service_role..."

# ---- Cron (บังคับ, >= 32 ตัวอักษร) ----
# สร้างด้วย: openssl rand -hex 32
CRON_SECRET=""

# ---- Marketing / Analytics (ไม่บังคับ แต่ถ้าไม่ใส่ฟีเจอร์จะขาด) ----
GA_ID=""
LINE_URL=""

# ---- Cloud Scheduler job ที่ 3 (ไม่บังคับ) ----
# ถ้าไม่ใส่ จะสร้างแค่ 2 job (operations-loop, gateway-workers)
SUPABASE_MGMT_TOKEN=""

# ---- คำยืนยัน deploy (ปล่อย no ไว้จนกว่าจะรันจริง) ----
CONFIRM_DEPLOY="no"
