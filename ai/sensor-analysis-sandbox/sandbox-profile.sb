;; หน้าที่: kernel-enforced boundary for ai/sensor-analysis-sandbox/ (Owner,
;; 2026-08-26). Applied by ./run-sandbox.sh to every model run — not an
;; optional extra mode.
;;
;; `env -i` in the launcher removes the credentials. This removes the
;; capability: even a process that somehow obtained a token cannot open a
;; socket, and cannot read this repository. Measured, not assumed — the model
;; produces its normal output with both denials in force, and
;; tests/isolation-proof.test.ts re-takes that measurement.
;;
;; The two `allow file-read*` literals are the launcher and the runner
;; themselves, which sit inside the repo and must stay readable for the process
;; to exist at all. Nothing else in the repo is reachable: not the source, not
;; .railway/railway.ts, not the sensor data files.

(version 1)
(allow default)

;; No independent network access. The model is loaded from the local
;; huggingface cache (HF_HUB_OFFLINE=1 in the launcher); nothing else on this
;; path has any reason to reach the network, and now nothing can.
(deny network*)

;; No repository access: no source, no config, no credentials-in-files, no
;; sensor jsonl. The model's whole world is the input file in its cwd.
(deny file-read* (subpath "/Users/tam/Desktop/DNA-OS-INFRASTRUCTURE"))
(deny file-write* (subpath "/Users/tam/Desktop/DNA-OS-INFRASTRUCTURE"))
(allow file-read*
  (literal "/Users/tam/Desktop/DNA-OS-INFRASTRUCTURE/ai/sensor-analysis-sandbox/run-sandbox.sh")
  (literal "/Users/tam/Desktop/DNA-OS-INFRASTRUCTURE/ai/sensor-analysis-sandbox/sandbox-runner.py"))
