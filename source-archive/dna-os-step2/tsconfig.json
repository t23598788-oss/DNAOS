{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"],
      "@/types/*": ["./core/shared/*"],
      "@/drivers/*": ["./plugins/drivers/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": [
    "node_modules",
    "supabase/functions/**/*",
    "control",
    "connections",
    "software",
    "contracts",
    "credentials",
    "governance",
    "observability",
    "permissions",
    "providers",
    "transport",
    "dna-os-circuit",
    "execution",
    "ai",
    "audit",
    "reports",
    "engine-prototype",
    "engine-prototypeไลน์",
    "tests",
    "test-fixtures",
    "local-runtime/dna-dev-app-host",
    "scripts/register-runtime-control-2026-08-22.ts",
    "scripts/register-railway-migration-capabilities-2026-08-24.ts",
    "scripts/register-new-capabilities-2026-08-22.ts",
    "scripts/register-local-postgres-credential.ts",
    "scripts/register-supabase-postgres-credential.ts"
  ]
}
