{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Install dependencies",
      "type": "shell",
      "command": "npm install",
      "inAgents": true,
      "runOptions": {
        "runOn": "worktreeCreated"
      },
      "presentation": {
        "reveal": "silent",
        "panel": "shared"
      }
    },
    {
      "label": "Start dev server",
      "type": "shell",
      "command": "npm run dev",
      "inAgents": true,
      "presentation": {
        "reveal": "always",
        "panel": "new"
      },
      "isBackground": true
    },
    {
      "label": "Type check",
      "type": "shell",
      "command": "npm run type-check",
      "inAgents": true,
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "Lint check",
      "type": "shell",
      "command": "npm run lint",
      "inAgents": true,
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "System health check",
      "type": "shell",
      "command": "npm run status",
      "inAgents": true,
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "Architecture health",
      "type": "shell",
      "command": "npm run arch-health",
      "inAgents": true,
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "Build for production",
      "type": "shell",
      "command": "npm run build",
      "inAgents": true,
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    }
  ]
}
