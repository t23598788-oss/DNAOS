    "GET_WINDOW_LIST":    { "executor": "window",        "method": "list",           "permission": null },
    "READ_WINDOW":        { "executor": "accessibility",  "method": "readWindow",    "permission": "accessibility" },
    "CAPTURE_WINDOW":     { "executor": "window",        "method": "capture",        "permission": "screen_recording" },
    "OCR_WINDOW":         { "executor": "window",        "method": "ocr",            "permission": "screen_recording" },
    "CLICK":              { "executor": "accessibility",  "method": "click",         "permission": "accessibility" },
    "TYPE_TEXT":          { "executor": "accessibility",  "method": "typeText",      "permission": "accessibility" },
    "PRESS_KEY":          { "executor": "accessibility",  "method": "pressKey",      "permission": "accessibility" },
    "SCROLL":             { "executor": "accessibility",  "method": "scroll",        "permission": "accessibility" },
    "OPEN_URL":           { "executor": "urlScheme",      "method": "open",          "permission": null },
