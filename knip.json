{
  "$schema": "https://unpkg.com/knip@latest/schema.json",
  "entry": [
    "app/**/*.{ts,tsx}",
    "core/runtime/engine.ts",
    "engines/index.ts",
    "engines/business.ts",
    "plugins/index.ts",
    "gateway/index.ts",
    "registry/index.ts"
  ],
  "project": [
    "app/**/*.{ts,tsx}",
    "components/**/*.{ts,tsx}",
    "core/**/*.ts",
    "gateway/**/*.ts",
    "engines/**/*.ts",
    "cognitive/**/*.ts",
    "presenter/**/*.ts",
    "services/**/*.ts",
    "plugins/**/*.ts",
    "registry/**/*.ts"
  ],
  "ignore": [
    "next-env.d.ts",
    "supabase/functions/**",
    "plugins/line/**",
    "**/*.test.ts",
    "core/workspace/composer/**",
    "core/workspace/orchestrator/**",
    "core/workspace/planner/**",
    "plugins/platform/mac/**",
    "presenter/index.ts",
    "presenter/ranker.ts",
    "services/ai/translator.ts",
    "services/supabase/realtime.ts",
    "cognitive/intent/index.ts",
    "cognitive/knowledge/index.ts",
    "cognitive/priority/index.ts",
    "components/workspace/WorkspaceContext.tsx",
    "core/auth/index.ts",
    "engines/impact/engine.ts",
    "components/admin/AdminSidebarNav.tsx",
    "services/ai/bridge-local.ts",
    "services/ai/bridge-openai.ts"
  ],
  "ignoreDependencies": [
    "@tailwindcss/postcss",
    "eslint-config-next",
    "three",
    "@types/three",
    "tailwindcss",
    "@types/chokidar"
  ],
  "ignoreBinaries": [
    "top",
    "awk",
    "tail",
    "memory_pressure"
  ]
}
