{
  "$schema": "https://unpkg.com/knip@latest/schema.json",
  "entry": [
    "app/**/*.{ts,tsx}",
    "lib/runtime/engine.ts",
    "lib/v3-engines/index.ts",
    "lib/v3-engines/business.ts",
    "lib/v6-executor/index.ts",
    "lib/v6-executor/gateway.ts",
    "lib/registry/index.ts"
  ],
  "project": [
    "app/**/*.{ts,tsx}",
    "components/**/*.{ts,tsx}",
    "lib/**/*.ts"
  ],
  "ignore": [
    "next-env.d.ts",
    "supabase/functions/**",
    "lib/drivers/line/**"
  ],
  "ignoreDependencies": [
    "@tailwindcss/postcss",
    "eslint-config-next"
  ]
}
