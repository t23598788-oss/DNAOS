{
  "$schema": "https://unpkg.com/knip@latest/schema.json",
  "entry": [
    "app/**/*.{ts,tsx}",
    "core/runtime/engine.ts",
    "engines/index.ts",
    "engines/business.ts",
    "plugins/index.ts",
    "gateway/index.ts",
    "registry/index.ts"
  ],
  "project": [
    "app/**/*.{ts,tsx}",
    "components/**/*.{ts,tsx}",
    "core/**/*.ts",
    "gateway/**/*.ts",
    "engines/**/*.ts",
    "cognitive/**/*.ts",
    "presenter/**/*.ts",
    "services/**/*.ts",
    "plugins/**/*.ts",
    "registry/**/*.ts"
  ],
  "ignore": [
    "next-env.d.ts",
    "supabase/functions/**",
    "plugins/line/**"
  ],
  "ignoreDependencies": [
    "@tailwindcss/postcss",
    "eslint-config-next"
  ]
}
