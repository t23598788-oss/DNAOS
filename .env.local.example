# Supabase (required for Next.js frontend)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Integration Gateway — Observe Channel webhook ingress
# (app/api/gateway/observe/github/route.ts, app/api/gateway/observe/vercel/route.ts).
# Same value as each provider's webhook "secret" setting — verified via HMAC,
# never used for anything beyond signature verification.
GITHUB_WEBHOOK_SECRET=
VERCEL_WEBHOOK_SECRET=

# Meta webhook ingress (app/api/gateway/observe/meta/route.ts — Facebook
# Messenger + Instagram Messaging, owner channel-expansion 2026-10-07).
# META_APP_SECRET = the App Secret from Meta App Dashboard (App settings >
#   Basic) — verifies X-Hub-Signature-256 (sha256= + HMAC-SHA256 of raw body).
# META_VERIFY_TOKEN = any string YOU choose; Meta echoes it in the GET
#   hub.verify_token challenge when you register the callback URL.
# ไม่มีค่า = endpoint ตอบ 503 fail-closed (ยังไม่มีการรับข้อมูลจาก Meta)
# ก่อนเปิด endpoint จริง: ต้อง apply migration
# 20261007000001_propose_meta_gateway_providers.sql ก่อน (ดูผลกระทบในไฟล์)
META_APP_SECRET=
META_VERIFY_TOKEN=

# Longdo Map Search API (engines/geocoding.ts) — converts a customer's typed
# Thai address into lat/lng when they don't share a live LINE location pin.
LONGDO_MAP_API_KEY=

# Connect internal bridges (provider-neutral) — secret ต่อ bridge หนึ่งตัว
# (รูปแบบเดียวกับ LINE_COMMAND/CANONICAL_JOB/DOCUMENT_ARTIFACT ข้างบน).
# CONNECT: POST /api/internal/connect/event (business events · P3/D5) —
# Deno side ใช้ _shared/connect-event.ts · ตั้งทั้ง Next และ Supabase secrets
# (คู่กับ DNA_OS_APP_URL ฝั่ง Edge) — ไม่มีค่า = bridge ตอบ 503 fail-closed
CONNECT_INTERNAL_SECRET=
# PAYMENT_CONFIRM: POST /api/internal/connect/payment-confirm (P4/D2=ก,
# 2026-09-24 — เส้นยืนยันรับเงินอัตโนมัติของ LINE เข้า canonical writer;
# Deno side ใช้ _shared/connect-payment.ts · ตั้งทั้ง Next และ Supabase
# secrets คู่กับ DNA_OS_APP_URL) — ไม่มีค่า = auto-confirm ค้าง Pending
# Review ให้คนจัดการ (fail-closed by design ไม่มี fallback เส้นเงินสำรอง)
PAYMENT_CONFIRM_INTERNAL_SECRET=
# INBOUND_SOURCE: POST /api/internal/connect/inbound-source (P4b, 2026-09-24 —
# ประตูสร้าง receipt_documents ของ claim/OCR จาก LINE · Deno side ใช้
# _shared/connect-inbound.ts · ตั้งทั้ง Next และ Supabase secrets คู่กับ
# DNA_OS_APP_URL) — ไม่มีค่า = claim/OCR แถวใหม่เกิดไม่ได้ fail-closed
# (caller ของ bridge จัดการ error เอง ไม่มีการ insert ตรง fallback)
# เพิ่ม 2026-10-07: local-runtime scripts (watch-drive / backfill-slips*) อ่าน
# key เดียวกันจากไฟล์นี้ผ่าน local-runtime/connect-inbound.mjs — ไม่มีค่า =
# สคริปต์พวกนี้สร้างแถวไม่ได้ fail-closed (fail แล้ว retry รอบถัดไป ไม่มี
# fallback เขียนตรง)
INBOUND_SOURCE_INTERNAL_SECRET=
# EXPENSE: POST /api/internal/connect/expense (D3 deferred work landed,
# 2026-09-24 — เส้นเงินออก: expense.record / payable.request /
# payable.transition จาก LINE · Deno side ใช้ _shared/connect-expense.ts ·
# ตั้งทั้ง Next และ Supabase secrets คู่กับ DNA_OS_APP_URL) — ไม่มีค่า =
# เงินออกฝั่ง LINE log error แล้วดำเนินต่อแบบไม่มีแถวใหม่ (fail-closed
# ไม่มีการเขียนตรง fallback)
EXPENSE_INTERNAL_SECRET=

# Edge-cron -> Next.js internal bridge (app/api/internal/line/document-artifact/
# route.ts) — Supabase Edge Functions (Deno) call this to generate a real PDF/
# image document (pdfkit/sharp are Node-only) and push it to a LINE contact.
# Used by supabase/functions/line-webhook-v2/engines/auto-confirm-payment.ts to
# send a real receipt after an autonomous payment confirmation.
DOCUMENT_ARTIFACT_INTERNAL_SECRET=
# Must also be set as a Supabase Edge Function secret (same value), plus:
# APP_BASE_URL= (the deployed app's base URL, e.g. https://dnaos.dev) — set as
# an Edge Function secret only; Deno resolves it via Deno.env.get, not this file.

# OpenClaw + Pinto mobile channel -> Next.js internal bridge
# (app/api/internal/openclaw/command/route.ts) — Supabase Edge Function
# supabase/functions/openclaw-webhook calls this to run a text command from
# the phone (via the self-hosted OpenClaw gateway + Pinto chat plugin,
# repo: openclaw-fakduai-pinto) through the cognitive pipeline. Same
# preview-then-confirm rules as every other channel (Rule 72) — this bridge
# only proposes; the user must send an explicit follow-up (e.g. "ส่งเลย") to
# execute a pending action.
OPENCLAW_INTERNAL_SECRET=
# Must also be set as a Supabase Edge Function secret (same value), plus:
# OPENCLAW_WEBHOOK_SECRET= (must match the Pinto channel's `webhookSecret` on
#   the OpenClaw gateway, and the `signing_secret` on the "openclaw-pinto"
#   Connector — see app/admin/connectors)
# DNA_OS_APP_URL= (this app's public base URL, e.g. https://dnaos.example.com)
# All three are Edge Function secrets only; Deno resolves them via
# Deno.env.get, not this file.

# Equipment GPS/Relay Permission System (engines/equipment/relay-command.ts) —
# NOT chosen yet (owner, 2026-07-24: "ยังไม่มี ขอเขียนโค้ดโครงก่อน"). Gated
# cleanly until a real SMS gateway provider is picked.
SMS_GATEWAY_API_URL=
SMS_GATEWAY_API_KEY=

# Equipment GPS/Relay — Telemetry Ingestion (app/api/internal/equipment/
# telemetry/route.ts, implemented 2026-08-04) — bearer secret the GPS
# box's SMS/IoT gateway provider must send back once chosen. No provider
# chosen yet; this route works today for any caller that has the secret.
EQUIPMENT_TELEMETRY_SECRET=

# Equipment GPS/Relay — Edge-cron -> Next.js internal lock bridge
# (app/api/internal/equipment/lock-command/route.ts, implemented
# 2026-08-04) — supabase/functions/equipment-maintenance-cron calls this to
# fire the real relay-command.ts lock path for +50h-overdue and 17:00
# shift-end auto-lock (Deno cannot import the Node engine directly).
EQUIPMENT_LOCK_INTERNAL_SECRET=
# Must also be set as a Supabase Edge Function secret (same value), plus:
# EQUIPMENT_MAINTENANCE_CRON_SECRET= (the cron's own inbound auth secret)
# APP_BASE_URL= (already used by document-artifact — reused, not duplicated)
# All Edge Function secrets only; Deno resolves them via Deno.env.get, not
# this file.

# LINE Rich Menu id (registry/line-richmenu.ts) — NOT created yet (owner,
# 2026-07-24: needs a real uploaded button image + tap areas via LINE's
# Create Rich Menu API first, a one-time manual/design step this repo does
# not automate). Gated cleanly until it exists.
LINE_RICHMENU_START_ID=

# ── Owner-verification bridge (core/owner-verification-client.ts — BATCH 1) ──
# Approval paths (gateway proposals decide + dev-loop approve) are fail-closed:
# an approval must carry owner_verification_artifact verified by the
# infrastructure transport route POST /owner/session/from-verification-artifact
# (transport/owner-command-http/server.ts of -DNA-OS-INFRASTRUCTURE-, deployed
# on Railway owner-command-http). Rejections are NOT gated.
# Origin of that transport: local default http://127.0.0.1:8791, or the
# owner-command-http Railway URL when reaching it over the network.
INFRA_OWNER_VERIFICATION_URL=
# Shared secret — MUST be the same value as OWNER_COMMAND_HTTP_SHARED_SECRET
# on the owner-command-http service (the infrastructure's own secret name).
OWNER_COMMAND_HTTP_SHARED_SECRET=

# Resource-transaction canonical bridge (generic — machinery/telematics hours,
# เดิมเปิดใช้ผ่าน email webhook ที่เลิกใช้แล้ว BATCH 24):
#   producer → POST /api/internal/connect/resource-transaction → canonical writer
#   (engines/canonical/resource-transaction-write.ts)
# — RESOURCE_TRANSACTION_INTERNAL_SECRET: bridge secret ฝั่ง Next (route นี้)
#   + Supabase function secret (producer ส่งผ่าน header
#   x-resource-transaction-internal-secret).
#   *** ทั้งสองฝั่ง MUST ใช้ค่าเดียวกัน *** — ไม่ตรง/ไม่มี = 401/503
#   fail-closed · ห้าม commit ค่าจริง · โค้ดไม่มีการ print/log ค่านี้.
RESOURCE_TRANSACTION_INTERNAL_SECRET=
# ── Public website (2026-10-24 unified entry) ────────────────────────────────
# Canonical absolute origin of THIS deployment (sitemap/robots/JSON-LD).
# No domain literal is ever written in app code.
NEXT_PUBLIC_APP_URL=
# Public LINE Official Account add-friend URL (e.g. https://line.me/R/ti/p/@yourid
# or https://line.me/R/oaMessage/@yourid/ for a prefilled message). Left EMPTY on
# purpose: no real OA URL exists in this repo yet, and the public site shows an
# honest "not configured" state rather than an invented account.
NEXT_PUBLIC_LINE_OA_URL=

# Gateway observe (new channels) — secrets only, never commit real values
TELEGRAM_WEBHOOK_SECRET=
WHATSAPP_APP_SECRET=

# Connect (new) — internal bridge secret
TRIP_DELIVERY_INTERNAL_SECRET=

# Gateway execute channel gate (must be "true" to enable)
INTEGRATION_GATEWAY_EXECUTE_ENABLED=

# AI gateway internal bridge secret
AI_GATEWAY_INTERNAL_SECRET=

# Cron auth secret (used by internal scheduled jobs)
CRON_SECRET=
