node_modules/
.env
.env.local
.env.*.local
.DS_Store
*.log
.npmrc
.npm-cache/

# Live, in-process coordination/lock state — committing this resurrects
# dead lock holders on a fresh checkout and blocks real work until leases
# expire (found live, peer review, 2026-08-24).
local-runtime/process-locks/
local-runtime/coordination/

# High-churn generated data — regenerated by running the real capability,
# never hand-edited. verification-ledger.jsonl is deliberately NOT here —
# it is the real evidence lineage the Live Census derives from.
software/registry-database/data/
tests/__sandbox__/

# Compiled output of control/conversation-runtime/tsconfig.build.json —
# regenerate with `npm run conversation-runtime:build` before starting the
# production conversation runtime; never hand-edited, never the source of
# truth (Owner UNLOCK 2026-09-06, REMOVE_TSX_FROM_PRODUCTION_CONVERSATION_RUNTIME).
control/conversation-runtime/dist/
control/scheduler/data/*.jsonl
software/live-census/data/last-census.json

# Machine-local process cursors (byte offset + timestamp into a local
# session transcript) — regenerates continuously by design, committing it
# just churns diffs and leaks a local absolute file path (found live,
# 2026-08-24, during migration push prep).
connections/os-ui/data/*.cursor.json

# Recorded voice/audio evidence — real captured audio content, not source
# code. Genuinely large (one file was 2.8GB) and a real sensitivity risk if
# pushed to a shared GitHub repo (found live, 2026-08-24, during migration
# push prep — required a local git history rewrite to remove after being
# committed once by mistake).
connections/voice-command/data/observation-audio/
connections/human-verified-text/data/sessions/

# Recorded SCREEN observation — same class as the captured audio above, and
# excluded for the same reason: these are recordings of the Owner's machine,
# not source. 108 files, each holding the foreground app, the window title,
# the on-screen text (`visible_text_redacted`) and the accessibility controls
# — and the control entries carry `"redacted": false`, so real on-screen text
# is present despite the field name. Any capture that happened while mail,
# chat, a token or a password manager was on screen would carry that text into
# a permanent commit (Owner decision, 2026-08-24).
connections/os-ui/data/screen-reads/

# สถานะงานที่กำลังทำอยู่จริงบนเครื่องนี้ — runtime data ของ
# control/work-session-state/ ไม่ใช่ source. เป็นชนิดเดียวกับ
# local-runtime/coordination/ ข้างบน และถูกกันไว้ด้วยเหตุผลเดียวกัน:
# journal นี้ถือ objective/blocker/next action ของ session ที่กำลังรัน ซึ่ง
# เปลี่ยนทุกครั้งที่มี worker ทำงาน การ commit มันจะทำให้ทุก branch ชนกัน
# ที่ไฟล์เดียว และทำให้สถานะเครื่องหนึ่งกลายเป็นสถานะของทุกเครื่อง
local-runtime/work-session-state/

# ── canonical baseline hygiene (2026-09-03) ────────────────────────────────
# เหตุผลเดียวกันทั้งบล็อก: ระบบสร้างไฟล์พวกนี้เองตอนรัน ไม่มีใครแก้ด้วยมือ
# จึงไม่ใช่ "คำนิยาม" ที่ baseline ต้องตรึง — เป็น "ผลลัพธ์"

# sandbox profile ที่ agent-host สร้างใหม่ทุกครั้งที่ปล่อย agent (1 ไฟล์/1 launch)
.agent-host-profiles/
control/agent-host/test-workspace/

# ภาพหน้าจอที่ computer-use/os-ui ถ่ายไว้เป็นหลักฐาน — 345MB และโตเรื่อย ๆ
connections/os-ui/data/screenshots/

# บันทึกราย action ของ computer-use (1 ไฟล์/1 action)
control/computer-use-executor/data/processed/
control/computer-use-executor/data/results/

# projection ที่ system-graph สร้างจาก source — regenerate ได้เสมอ
software/system-graph/data/

# สำเนาสำรองก่อนแก้ไฟล์ ไม่ใช่ source
*.bak
*.pre-ownership

# Python bytecode
__pycache__/
*.pyc

# supabase CLI state ต่อเครื่อง ไม่ใช่ source
supabase/.temp/
# ที่พักไฟล์ชั่วคราว
tmp/

# .app bundle ที่ build.sh สร้างจาก launcher.template.sh + Info.plist
local-runtime/dna-dev-app-host/build/DNA DEV.app/

# log การ poll สถานะ launchd — 114MB / 157,820 บรรทัด และโตทุกวินาที
# ไม่มีใครอ่านย้อนหลัง ไม่ใช่คำนิยาม
control/runtime-control/data/operations.jsonl
