# dependencies
/node_modules
scripts/bank-statement-sync/node_modules

# File Existence Intelligence — local content-addressed snapshot store
# (engines/workspace/snapshotStore.ts). Never committed: may contain full
# content of files that were never meant to be tracked in the first place.
/.dna-os
scripts/bank-statement-sync/debug-*.png
scripts/bank-statement-sync/debug-*.html
scripts/bank-statement-sync/last-statement-parse.json
local-runtime/.runpod-last-active
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# Playwright (TASK-070, capability #62 STEP 1 — real /admin/ide UI audit
# infrastructure) — real, per-run output/traces and the real saved Supabase
# session storage state (contains live session cookies, must never be
# committed).
/test-results
/playwright-report
/blob-report
/playwright/.cache
e2e/.auth

# next.js
/.next/
/out/

# Local build artifacts — never part of git history: A4/PDF export output and
# scratch build scripts (tmp/pdfs/build-a4-vector.mjs). The editable sources
# live in presentation/assets/document-a4/; regenerate output/ locally.
/output/
/tmp/

# production
/build

