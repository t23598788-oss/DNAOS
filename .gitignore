# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
scripts/bank-statement-sync/node_modules

# File Existence Intelligence — local content-addressed snapshot store
# (engines/workspace/snapshotStore.ts). Never committed: may contain full
# content of files that were never meant to be tracked in the first place.
/.dna-os
scripts/bank-statement-sync/debug-*.png
scripts/bank-statement-sync/debug-*.html
scripts/bank-statement-sync/last-statement-parse.json
local-runtime/.runpod-last-active
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# database backups (contain real business data)
/backups

# vercel
.vercel

# /admin/ide workspace trash (owner, 2026-08-05, Phase 3) — trashed items
# and their metadata ledger must never be committed
.dnaos-trash

# typescript
*.tsbuildinfo
next-env.d.ts
lib/macos/line-ctrl
lib/drivers/line/line-driver
lib/macos/line-ctrl
lib/drivers/line/line-driver
