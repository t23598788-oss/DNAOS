{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "DNA OS",
  "version": "0.1.0",
  "identifier": "com.dnaos.app",
  "build": {
    "frontendDist": "../.next-tauri-placeholder",
    "devUrl": "http://localhost:3000"
  },
  "app": {
    "windows": [
      {
        "title": "DNA OS — ควบคุมแชทลูกค้า",
        "url": "https://dnaos.dev/admin/relationships",
        "width": 1440,
        "height": 900,
        "resizable": true,
        "fullscreen": false,
        "maximized": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
