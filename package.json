    "intelligence": "bash scripts/intelligence.sh",
    "existence": "bash scripts/existence.sh",
    "status": "bash scripts/dashboard.sh && bash scripts/intelligence.sh && bash scripts/existence.sh",
    "diagnosis": "npx tsx lib/runtime/self-awareness.ts",
    "existence-intelligence": "npx tsx lib/runtime/existence-intelligence.ts",
    "cockpit": "npx tsx lib/runtime/cockpit.ts",
    "why": "npx tsx lib/runtime/cockpit.ts why",
    "dbd": "npx tsx lib/runtime/dbd.ts",
    "precommit": "bash scripts/pre-commit-check.sh"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.108.2",
    "next": "16.2.9",
    "openai": "^6.44.0",
    "react": "19.2.4",
