{
  "name": "dna-os",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "dna-os-mcp-server"
  ],
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "dev": "next dev",
    "prebuild": "npx tsx scripts/deploy-gate.ts",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "type-check": "tsc --noEmit",
    "dead-code": "knip --no-progress",
    "duplicates": "jscpd",
    "guard": "bash scripts/governance.sh",
    "dashboard": "bash scripts/dashboard.sh",
    "intelligence": "bash scripts/intelligence.sh",
    "existence": "bash scripts/existence.sh",
    "status": "bash scripts/dashboard.sh && bash scripts/intelligence.sh && bash scripts/existence.sh",
    "hello": "npx tsx scripts/hello.ts",
    "sync-demand": "npx tsx scripts/sync-owner-requests.ts",
    "sync-infra-deps": "npx tsx scripts/sync-infrastructure-dependencies.ts",
    "deploy-gate": "npx tsx scripts/deploy-gate.ts",
    "verify-env": "bash scripts/verify-environment.sh",
    "diagnosis": "npx tsx core/runtime/self-awareness.ts",
    "existence-intelligence": "npx tsx core/runtime/existence-intelligence.ts",
    "cockpit": "npx tsx core/runtime/cockpit.ts",
    "why": "npx tsx core/runtime/cockpit.ts why",
    "dbd": "npx tsx core/runtime/dbd.ts",
    "precommit": "bash scripts/pre-commit-check.sh",
    "arch-health": "npx tsx scripts/build-arch-book.ts && npx tsx scripts/arch-health-report.ts",
    "backup": "npx tsx scripts/backup.ts",
    "restore": "npx tsx scripts/backup.ts restore",
    "sync": "npx tsx scripts/sync-registry.ts && npx tsx scripts/build-arch-book.ts",
    "watch": "npx tsx scripts/watch-registry.ts",
    "new-module": "npx tsx scripts/new-module.ts",
    "arch": "npx tsx scripts/build-arch-book.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@fontsource/noto-sans-thai": "^5.2.8",
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.108.2",
    "@tauri-apps/api": "^2.11.1",
    "glob": "^13.0.6",
    "lucide-react": "^1.23.0",
    "next": "16.2.9",
    "pdfkit": "^0.19.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-force-graph-3d": "^1.29.1",
    "sharp": "^0.35.3",
    "three": "^0.185.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@tauri-apps/cli": "^2.11.4",
    "@types/chokidar": "^2.1.3",
    "@types/node": "^20",
    "@types/pdfkit": "^0.17.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.185.0",
    "chokidar": "^3.6.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "jscpd": "^5.0.11",
    "knip": "^6.22.0",
    "tailwindcss": "^4",
    "tsx": "^4.22.4",
    "typescript": "^5"
  }
}
