{
  "name": "dna-os",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "type-check": "tsc --noEmit",
    "dead-code": "knip --no-progress",
    "duplicates": "jscpd",
