{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "dnaos-developer-portal",
  "compatibility_date": "2026-11-27",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "html_handling": "drop-trailing-slash"
  },
  "routes": [
    { "pattern": "dnaos.dev/developers", "zone_name": "dnaos.dev" },
    { "pattern": "dnaos.dev/developers/*", "zone_name": "dnaos.dev" },
    { "pattern": "dnaos.dev/api/v1/spec", "zone_name": "dnaos.dev" }
  ]
}
