{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "dnaos-meta-webhook",
  "main": "index.ts",
  "compatibility_date": "2026-11-24",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "dnaos.dev/api/gateway/observe/meta",
      "zone_name": "dnaos.dev"
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "persist": true,
      "invocation_logs": true
    }
  }
}
