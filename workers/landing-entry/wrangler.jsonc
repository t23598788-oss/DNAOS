{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "dnaos-homepage",
  "main": "index.ts",
  "compatibility_date": "2026-11-23",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "dnaos.dev/", "zone_name": "dnaos.dev" },
    { "pattern": "dnaos.dev/assets/*", "zone_name": "dnaos.dev" }
  ],
  "assets": {
    "directory": "../../public/landing-preview",
    "binding": "ASSETS",
    "not_found_handling": "404-page"
  },
  "observability": { "enabled": true }
}
